PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=db_gamelab_indonesia

# Gunakan nilai acak yang panjang. Jangan unggah file .env.
JWT_SECRET=isi-dengan-secret-acak-minimal-32-karakter
JWT_EXPIRES_IN=1d
EXTERNAL_API_KEY=isi-dengan-api-key-acak

# Hanya dipakai sekali untuk membuat admin awal.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ganti-dengan-password-kuat-sementara
